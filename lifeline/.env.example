# Lifeline environment — copy to .env

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend
JAC_ROOT=/app/jac
JAC_API_URL=http://localhost:8001
API_HOST=0.0.0.0
API_PORT=8000

# Optional audit/event mirror (Jac remains the source of truth)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=lifeline

# byLLM via OpenRouter (copy to .env; never commit real secrets)
BYLLM_MODEL=openrouter/google/gemma-4-26b-a4b-it:free
OPENROUTER_API_KEY=
# Compatibility aliases used by Jac/byLLM's OpenAI-compatible transport.
BYLLM_DEFAULT_MODEL=${BYLLM_MODEL}
OPENAI_API_KEY=${OPENROUTER_API_KEY}
OPENAI_API_BASE=https://openrouter.ai/api/v1
