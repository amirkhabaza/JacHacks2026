# Lifeline environment — copy to .env

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend
JAC_ROOT=/app/jac
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=lifeline
API_HOST=0.0.0.0
API_PORT=8000

# byllm / model keys (used by Jac by llm() — never commit real secrets)
# OPENAI_API_KEY=
# BYLLM_MODEL=
